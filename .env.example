NODE_ENV=development
PORT=3001

# Use a local or non-production database URL for development.
# Do not commit real production credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veyra_core

# Prisma uses a separate pg pool while legacy DatabaseService remains active.
PRISMA_DATABASE_POOL_MAX=5
PRISMA_DATABASE_CONNECTION_TIMEOUT_MS=5000

# Optional shared secret n8n can send as `x-core-api-key`.
# CORE_API_KEY=replace-with-local-development-secret

# Required only when Core performs LLM extraction.
# OPENAI_API_KEY=replace-with-local-development-key
# OPENAI_TIMEOUT_MS=20000

# Optional Telegram direct-link base used by budget forecast buttons.
# VEYRA_MINI_APP_BASE_URL=https://t.me/your_bot/your_app

# Rovelle private Cloudflare R2 storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGN_TTL_SECONDS=900
